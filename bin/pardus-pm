#!/usr/bin/env bash
# Launcher for the Pardus Package Manager Add-On Tool.
# Uses the project virtualenv if present (Textual lives there), otherwise the
# system Python. Forwards all arguments to the dispatcher.
set -euo pipefail

# Resolve the real location even when launched via a symlink (e.g.
# /usr/bin/pardus-pm -> /path/to/checkout/bin/pardus-pm), so the venv and the
# parduspm package are always found in the actual checkout.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

if [ -x "$here/.venv/bin/python" ]; then
    python="$here/.venv/bin/python"
else
    python="$(command -v python3)"
fi

cd "$here"
exec "$python" -m parduspm "$@"
